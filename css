/* ============================================
   A TIRANIA CONSTITUCIONAL - ESTILO CINEMÁTICO
   Fundo Fixo + Cards Flutuantes
   Paleta: Preto, Vermelho, Dourado
   ============================================ */

/* --- VARIÁVEIS DE COR DA CAPA --- */
:root {
  /* Cores Extraídas da Capa */
  --cor-fundo-livro: #050505;       /* Quase preto absoluto */
  --cor-vermelho-sangue: #8b0000;   /* Vermelho escuro dramático */
  --cor-vermelho-vivo: #d32f2f;     /* Vermelho do título "CONSTITUCIONAL" */
  --cor-dourado-balanga: #b8860b;   /* Dourado antigo/bronze */
  --cor-branco-osso: #f5f5f5;       /* Branco ligeiramente amarelado (papel) */
  
  /* Estrutura dos Cards */
  --bg-card-translucido: rgba(10, 10, 10, 0.92); /* Permite ver a textura do fundo sutilmente */
  --border-card: 1px solid rgba(184, 134, 11, 0.3); /* Borda dourada fraca */
  --shadow-strong: 0 10px 30px rgba(0, 0, 0, 0.8);
  
  /* Fontes */
  --font-titulo: 'Cinzel', serif;
  --font-corpo: 'Lora', serif;
  --font-ui: 'Inter', sans-serif;
}

/* --- RESET E BASE COM FUNDO FIXO --- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-corpo);
  color: var(--cor-branco-osso);
  line-height: 1.7;
  overflow-x: hidden;
  
  /* EFEITO CHAVE: Imagem Fixa no Fundo */
  background-image: url('capa.jpg'); /* Certifique-se que o arquivo está aqui */
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  background-attachment: fixed; /* TRAVA A IMAGEM ENQUANTO O TEXTO ROLA */
  
  /* Camada Escura Global para Legibilidade */
  position: relative;
}

/* Overlay escuro semi-transparente sobre TODO o site para unificar o tom */
body::before {
  content: '';
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at center, rgba(5,5,5,0.7) 0%, rgba(0,0,0,0.95) 100%);
  z-index: -1; /* Fica atrás do conteúdo, mas na frente da imagem */
  pointer-events: none;
}

.container { max-width: 1100px; margin: 0 auto; padding: 0 20px; position: relative; z-index: 1; }

/* --- TIPOGRAFIA DRAMÁTICA --- */
h1, h2, h3, h4 { font-family: var(--font-titulo); text-transform: uppercase; letter-spacing: 1px; }
h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; }
h2 { font-size: clamp(2rem, 4vw, 2.5rem); color: var(--cor-dourado-balanga); margin-bottom: 1rem; }
h3 { font-size: 1.5rem; color: var(--cor-vermelho-vivo); margin-bottom: 0.5rem; }

p { color: #ccc; margin-bottom: 1.5rem; font-size: 1.05rem; }
strong { color: var(--cor-branco-osso); }
em { color: var(--cor-dourado-balanga); font-style: italic; }

a { color: var(--cor-vermelho-vivo); text-decoration: none; transition: 0.3s; border-bottom: 1px dotted transparent; }
a:hover { color: var(--cor-dourado-balanga); border-bottom-color: var(--cor-dourado-balanga); }

/* --- HERO SECTION (TOPO) --- */
.hero-bg-cover {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  /* Como o body já tem a imagem fixa, o hero pode ser transparente */
  background: transparent; 
}

.hero-content {
  max-width: 800px;
  padding: 2rem;
  animation: fadeUp 1s ease-out forwards;
}

.hero-label {
  font-family: var(--font-ui);
  font-size: 0.9rem;
  letter-spacing: 4px;
  color: var(--cor-dourado-balanga);
  text-transform: uppercase;
  margin-bottom: 1rem;
  display: block;
  opacity: 0.8;
}

.main-title span.red {
  display: block;
  color: var(--cor-vermelho-vivo);
  text-shadow: 0 0 20px rgba(211, 47, 47, 0.6); /* Brilho vermelho */
}

.subtitle-hero {
  font-family: var(--font-corpo);
  font-size: 1.2rem;
  color: #ddd;
  margin-top: 1rem;
  font-style: italic;
}

/* --- BOTÕES ESTILO LIVRO ANTIGO --- */
.btn {
  display: inline-block;
  padding: 12px 30px;
  font-family: var(--font-ui);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.85rem;
  letter-spacing: 2px;
  cursor: pointer;
  transition: all 0.3s ease;
  border-radius: 2px;
  margin: 10px;
}

.btn-red {
  background: var(--cor-vermelho-sangue);
  color: white;
  border: 1px solid var(--cor-vermelho-vivo);
  box-shadow: 0 4px 15px rgba(139, 0, 0, 0.4);
}
.btn-red:hover {
  background: var(--cor-vermelho-vivo);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(211, 47, 47, 0.6);
}

.btn-gold {
  background: transparent;
  color: var(--cor-dourado-balanga);
  border: 1px solid var(--cor-dourado-balanga);
}
.btn-gold:hover {
  background: var(--cor-dourado-balanga);
  color: black;
}

/* --- FAIXA INFORMATIVA (STRIP) --- */
.ficha-strip {
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(5px); /* Desfoxa a imagem de fundo atrás dela */
  border-top: 1px solid #333;
  border-bottom: 1px solid #333;
  padding: 15px 0;
  font-family: var(--font-ui);
  font-size: 0.85rem;
  color: #aaa;
}
.ficha-content { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px; }
.ficha-item strong { color: var(--cor-dourado-balanga); }

/* --- SEÇÕES GERAIS --- */
.section { padding: 80px 0; position: relative; }
.section-dark { background: transparent; /* Deixa o fundo aparecer */ }
.section-alt { background: rgba(10, 10, 10, 0.5); } /* Leve contraste */

.section-title {
  text-align: center;
  font-size: 2.2rem;
  color: var(--cor-branco-osso);
  margin-bottom: 50px;
  position: relative;
}
.section-title::after {
  content: '';
  display: block;
  width: 60px;
  height: 3px;
  background: linear-gradient(to right, var(--cor-vermelho-vivo), var(--cor-dourado-balanga));
  margin: 15px auto 0;
}

/* --- CARDS FLUTUANTES SOBRE O FUNDO --- */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 30px;
}

.card {
  background: var(--bg-card-translucido);
  border: var(--border-card);
  border-radius: 4px; /* Cantos menos arredondados = mais sério/jurídico */
  padding: 30px;
  transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-strong);
}

/* Efeito de brilho sutil no topo do card */
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 2px;
  background: linear-gradient(90deg, transparent, var(--cor-dourado-balanga), transparent);
  opacity: 0.5;
}

.card:hover {
  transform: translateY(-10px) scale(1.02);
  border-color: var(--cor-vermelho-vivo);
  box-shadow: 0 15px 40px rgba(0,0,0,0.9), 0 0 20px rgba(139,0,0,0.2);
  background: rgba(15, 15, 15, 0.98); /* Fica mais opaco no hover */
}

.card-icon { font-size: 2rem; margin-bottom: 15px; filter: grayscale(100%) brightness(150%); opacity: 0.7; }
.card-title { font-family: var(--font-titulo); font-size: 1.3rem; color: var(--cor-dourado-balanga); margin-bottom: 10px; }
.card-subtitle { font-size: 0.9rem; color: var(--cor-vermelho-vivo); font-style: italic; margin-bottom: 15px; }
.card-text { font-size: 0.95rem; color: #bbb; }

.card-list li { margin-bottom: 10px; padding-left: 15px; position: relative; font-size: 0.95rem; color: #ccc; }
.card-list li::before { content: '§'; position: absolute; left: 0; color: var(--cor-vermelho-vivo); font-weight: bold; }

.badge {
  display: inline-block;
  background: rgba(184, 134, 11, 0.1);
  color: var(--cor-dourado-balanga);
  padding: 4px 10px;
  border-radius: 2px;
  font-size: 0.75rem;
  margin-top: 15px;
  margin-right: 5px;
  border: 1px solid rgba(184, 134, 11, 0.3);
  font-family: var(--font-ui);
}

/* --- AUTOR E ÁUDIO --- */
.author-block {
  display: flex;
  gap: 40px;
  align-items: center;
  background: rgba(0,0,0,0.6);
  padding: 40px;
  border-radius: 4px;
  border: 1px solid #333;
  backdrop-filter: blur(10px);
}

.author-photo-wrap {
  width: 150px; height: 150px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--cor-dourado-balanga);
  flex-shrink: 0;
  box-shadow: 0 0 20px rgba(184, 134, 11, 0.3);
}
.author-photo { width: 100%; height: 100%; object-fit: cover; }

.author-name { font-family: var(--font-titulo); font-size: 1.8rem; color: white; margin-bottom: 5px; }
.author-role { color: var(--cor-vermelho-vivo); font-weight: bold; text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem; margin-bottom: 15px; }
.author-bio { color: #ddd; margin-bottom: 20px; }

.audio-caption { font-size: 0.9rem; color: #999; margin-bottom: 10px; font-style: italic; }
.audio-player { width: 100%; filter: invert(1) sepia(1) saturate(5) hue-rotate(15deg); opacity: 0.8; }

/* --- CAPÍTULO 9 (METODOLOGIA) --- */
.chapter-header { text-align: center; margin-bottom: 40px; }
.chapter-tag {
  background: var(--cor-vermelho-sangue);
  color: white;
  padding: 5px 15px;
  font-size: 0.8rem;
  font-weight: bold;
  text-transform: uppercase;
  display: inline-block;
  margin-bottom: 15px;
  letter-spacing: 2px;
}

.transparency-note {
  background: rgba(139, 0, 0, 0.1);
  border-left: 4px solid var(--cor-vermelho-vivo);
  padding: 20px;
  margin-bottom: 40px;
  font-size: 0.95rem;
  color: #eee;
}

.methodology-table {
  width: 100%;
  border-collapse: collapse;
  margin: 20px 0;
  font-size: 0.9rem;
  background: rgba(0,0,0,0.4);
}
.methodology-table th, .methodology-table td {
  padding: 12px 15px;
  text-align: left;
  border-bottom: 1px solid #333;
}
.methodology-table th { color: var(--cor-dourado-balanga); font-family: var(--font-titulo); background: rgba(20,20,20,0.8); }
.methodology-table tr:hover { background: rgba(255,255,255,0.05); }

.formula-box {
  background: #000;
  border: 1px solid var(--cor-vermelho-vivo);
  padding: 20px;
  font-family: monospace;
  font-size: 1.1rem;
  color: var(--cor-vermelho-vivo);
  text-align: center;
  margin: 20px 0;
  box-shadow: inset 0 0 20px rgba(139,0,0,0.2);
}

.resources-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 20px;
  margin-top: 30px;
}
.resource-card {
  background: rgba(10,10,10,0.8);
  padding: 20px;
  border-radius: 4px;
  border: 1px solid #333;
}
.resource-card h4 { color: var(--cor-dourado-balanga); margin-bottom: 10px; font-size: 1rem; }
.resource-link { display: block; color: #aaa; font-size: 0.85rem; margin-top: 5px; }
.resource-link:hover { color: white; text-decoration: underline; }

.qr-section {
  display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
  margin-top: 40px; padding-top: 40px; border-top: 1px dashed #444;
}
.qr-placeholder {
  width: 120px; height: 120px;
  background: white; /* QR precisa de fundo claro para funcionar bem visualmente */
  margin: 0 auto 10px;
  display: flex; align-items: center; justify-content: center;
  color: black; font-size: 0.7rem; text-align: center; padding: 5px;
  border: 2px solid var(--cor-dourado-balanga);
}
.qr-label { font-size: 0.8rem; color: var(--cor-dourado-balanga); text-align: center; }

/* --- FOOTER --- */
.site-footer {
  background: #000;
  padding: 40px 0;
  border-top: 2px solid var(--cor-vermelho-sangue);
  text-align: center;
  font-size: 0.85rem;
  color: #666;
}
.footer-title { font-family: var(--font-titulo); font-size: 1.2rem; color: white; margin-bottom: 10px; }
.footer-meta a { color: var(--cor-dourado-balanga); text-decoration: underline; }

/* --- RESPONSIVO --- */
@media (max-width: 768px) {
  .author-block { flex-direction: column; text-align: center; }
  .hero-bg-cover { background-attachment: scroll; /* Mobile não suporta fixed bem, volta ao normal */ }
  body { background-attachment: scroll; }
}

/* --- ANIMAÇÃO ENTRADA --- */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
